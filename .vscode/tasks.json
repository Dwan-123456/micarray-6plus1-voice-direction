{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "环境：创建或更新 v1.4.3 专用环境",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\setup_vscode_env.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "测试：当前规格全部自动测试",
      "type": "process",
      "command": "${workspaceFolder}\\.venv-v1.4\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "运行：Development Test UI",
      "type": "process",
      "command": "${workspaceFolder}\\.venv-v1.4\\Scripts\\python.exe",
      "args": ["-m", "gui.dev_test_ui.app"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}",
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
