{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行：Development Test UI",
      "type": "debugpy",
      "request": "launch",
      "module": "gui.dev_test_ui.app",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
