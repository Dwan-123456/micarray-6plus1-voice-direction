# Binary assets required to reproduce tests and CNN inference are versioned
# through Git LFS. Runtime recordings and the full local Test Corpus remain
# excluded by .gitignore.
**/*.wav filter=lfs diff=lfs merge=lfs -text
**/*.flac filter=lfs diff=lfs merge=lfs -text
**/*.npy filter=lfs diff=lfs merge=lfs -text
**/*.npz filter=lfs diff=lfs merge=lfs -text
**/*.safetensors filter=lfs diff=lfs merge=lfs -text
**/*.ckpt filter=lfs diff=lfs merge=lfs -text
**/*.nemo filter=lfs diff=lfs merge=lfs -text
**/*.onnx filter=lfs diff=lfs merge=lfs -text
**/*.pt filter=lfs diff=lfs merge=lfs -text
**/*.pth filter=lfs diff=lfs merge=lfs -text
docs/v1.4.3_existing_docs/references/*.pdf filter=lfs diff=lfs merge=lfs -text
docs/v1.4.3_existing_docs/references/*.png filter=lfs diff=lfs merge=lfs -text
docs/v1.4.3_existing_docs/L1_HARDWARE_CALIBRATION_*.json text eol=lf
docs/project_document/references/*.pdf filter=lfs diff=lfs merge=lfs -text
docs/project_document/assets/*.png filter=lfs diff=lfs merge=lfs -text
*.cmd text eol=crlf
